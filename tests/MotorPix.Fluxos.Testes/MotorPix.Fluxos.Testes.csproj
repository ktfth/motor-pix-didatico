<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MotorPix.Fluxos.Testes</RootNamespace>
    <AssemblyName>MotorPix.Fluxos.Testes</AssemblyName>
  </PropertyGroup>

  <!--
    Os testes de fluxo consomem o motor pelo composition root, como um host faria: nenhuma
