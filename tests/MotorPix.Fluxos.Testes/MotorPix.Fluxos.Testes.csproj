    <ProjectReference Include="..\..\src\MotorPix.Dominio\MotorPix.Dominio.csproj" />
    <ProjectReference Include="..\..\src\MotorPix.Mensagens\MotorPix.Mensagens.csproj" />
    <ProjectReference Include="..\..\src\MotorPix.Contratos\MotorPix.Contratos.csproj" />
    <ProjectReference Include="..\..\src\MotorPix.Psp.Nucleo\MotorPix.Psp.Nucleo.csproj" />
    <ProjectReference Include="..\..\src\MotorPix.Composicao\MotorPix.Composicao.csproj" />
    <ProjectReference Include="..\MotorPix.Testes.Comum\MotorPix.Testes.Comum.csproj" />
  </ItemGroup>

</Project>
